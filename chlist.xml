<!--
 chlist.xml
 Configuration for the channel list for the French NPVR service.
 Each channel has a unique identifier and displays metadata.

 Example:
 <channel id="ch1">
     <name>France 2</name>
     <category>News</category>
 </channel>
-->

<channel_set>
    <channel id="ch1">
        <name>France 2</name>
        <category>News</category>
    </channel>
    <channel id="ch2">
        <name>France 3</name>
        <category>General</category>
    </channel>
    <!-- Additional channels here -->
</channel_set>